{
  "name": "copilot-open-world-game",
  "version": "0.1.0",
  "description": "2D open-world pixel sandbox game with multiplayer, building, and in-game scripting",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev:server": "node --watch server/index.js",
    "dev:client": "cd client && npm run dev",
    "dev": "npm run dev:server & npm run dev:client",
    "build": "npm run build:client",
    "build:client": "cd client && npm run build",
    "start": "node server/index.js",
    "setup": "npm install && cd client && npm install"
  },
  "keywords": [
    "game",
    "multiplayer",
    "sandbox",
    "2d",
    "pixel",
    "open-world"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {}
}
